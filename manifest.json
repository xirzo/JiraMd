{
  "manifest_version": 3,
  "name": "Jira Markdown",
  "version": "1.0",
  "description": "Translates Jira Markdown to regular Markdown and vice-versa",
  "browser_specific_settings": {
     "gecko": {
       "id": "jira-md@example.com",
       "data_collection_permissions": {
           "required": ["none"]
       }
     }
  },
  "icons": {
    "16": "icons/border16.png",
    "32": "icons/border32.png",
    "128": "icons/border128.png"
  },
  "action": {
    "default_title": "Open Popup",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ]
}
